generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
}

enum RegStatus {
  PENDING
  JOINED
  REJECTED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  fullName      String
  password      String
  role          Role           @default(STUDENT)
  bio           String?
  createdAt     DateTime       @default(now())
  registrations Registration[]
}

model LessonSeason {
  id            String         @id @default(uuid())
  title         String
  presenter     String  
  durationHrs   Int
  startDate     DateTime
  endDate       DateTime
  capacity      Int?
  createdAt     DateTime       @default(now())
  registrations Registration[]
}

model Registration {
  id        String       @id @default(uuid())
  status    RegStatus    @default(PENDING)
  user      User         @relation(fields: [userId], references: [id])
  userId    String
  season    LessonSeason @relation(fields: [seasonId], references: [id])
  seasonId  String
  createdAt DateTime     @default(now())

  @@unique([userId, seasonId])
}